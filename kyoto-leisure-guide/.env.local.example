# Supabase 프로젝트 (kyoto-leisure-guide / nqrlgirdmyxvxogqmmvc)
# Supabase 대시보드 → Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google Maps Embed (장소 상세 지도용)
# Google Cloud Console → Maps Platform → Credentials 에서 발급
# HTTP referrer 제한 권장: https://kyoto-leisure-guide.vercel.app/*, http://localhost:3000/*
# 미설정 시 OpenStreetMap iframe으로 자동 fallback
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Anthropic (AI 추천)
# 미설정 시 /api/recommend 가 503 graceful 응답
ANTHROPIC_API_KEY=
